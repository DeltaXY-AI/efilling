{
  "name": "efilling-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp-based e-Filing MVP backend (Twilio WhatsApp Sandbox, Express, TypeScript).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "twilio:template:create": "tsx --env-file=.env twilio/scripts/create-language-template.ts",
    "twilio:template:verify": "tsx --env-file=.env twilio/scripts/verify-language-template.ts",
    "twilio:menu:create": "tsx --env-file=.env twilio/scripts/create-main-menu-templates.ts",
    "twilio:menu:verify": "tsx --env-file=.env twilio/scripts/verify-main-menu-templates.ts",
    "twilio:filing:create": "tsx --env-file=.env twilio/scripts/create-filing-templates.ts",
    "twilio:filing:verify": "tsx --env-file=.env twilio/scripts/verify-filing-templates.ts",
    "twilio:enrolment:create": "tsx --env-file=.env twilio/scripts/create-enrolment-templates.ts",
    "twilio:enrolment:verify": "tsx --env-file=.env twilio/scripts/verify-enrolment-templates.ts",
    "twilio:complainant:create": "tsx --env-file=.env twilio/scripts/create-complainant-templates.ts",
    "twilio:complainant:verify": "tsx --env-file=.env twilio/scripts/verify-complainant-templates.ts",
    "twilio:accused:create": "tsx --env-file=.env twilio/scripts/create-accused-templates.ts",
    "twilio:accused:verify": "tsx --env-file=.env twilio/scripts/verify-accused-templates.ts",
    "twilio:filing-details:create": "tsx --env-file=.env twilio/scripts/create-filing-details-templates.ts",
    "twilio:filing-details:verify": "tsx --env-file=.env twilio/scripts/verify-filing-details-templates.ts",
    "twilio:filing-sign:create": "tsx --env-file=.env twilio/scripts/create-filing-sign-templates.ts",
    "twilio:filing-sign:verify": "tsx --env-file=.env twilio/scripts/verify-filing-sign-templates.ts",
    "twilio:filing-completion:create": "tsx --env-file=.env twilio/scripts/create-filing-completion-templates.ts",
    "twilio:filing-completion:verify": "tsx --env-file=.env twilio/scripts/verify-filing-completion-templates.ts",
    "twilio:filing-draft-list:create": "tsx --env-file=.env twilio/scripts/create-filing-draft-list-templates.ts",
    "twilio:filing-draft-list:verify": "tsx --env-file=.env twilio/scripts/verify-filing-draft-list-templates.ts",
    "twilio:filing-defect:create": "tsx --env-file=.env twilio/scripts/create-filing-defect-templates.ts",
    "twilio:filing-defect:verify": "tsx --env-file=.env twilio/scripts/verify-filing-defect-templates.ts",
    "twilio:hearing:create": "tsx --env-file=.env twilio/scripts/create-hearing-templates.ts",
    "twilio:hearing:verify": "tsx --env-file=.env twilio/scripts/verify-hearing-templates.ts",
    "twilio:case-type:create": "tsx --env-file=.env twilio/scripts/create-case-type-templates.ts",
    "twilio:case-type:verify": "tsx --env-file=.env twilio/scripts/verify-case-type-templates.ts",
    "hearing:send-reminders": "tsx --env-file=.env src/scripts/send-hearing-reminders.ts",
    "hearing:set-test-date": "tsx --env-file=.env src/scripts/set-test-hearing-date.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "libphonenumber-js": "^1.13.10",
    "pdfkit": "^0.19.1",
    "twilio": "^6.0.2",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "pdf-parse": "^2.4.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
