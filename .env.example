# Server
# development | test | production
NODE_ENV=development
# Port for local development (ignored on Vercel)
PORT=3000

# Twilio WhatsApp Sandbox
# See docs/twilio-sandbox-setup.md for how to obtain these values.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Content SID of the oncourts_language_selection_v1 template. Create/reuse it
# with `npm run twilio:template:create` — see twilio/templates/language-selection.json.
TWILIO_LANGUAGE_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Content SIDs of the localized main-menu list-picker templates. Create/reuse
# them with `npm run twilio:menu:create` — see
# twilio/templates/complainant-advocate-menu.{en,ml}.json.
TWILIO_MAIN_MENU_CONTENT_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MAIN_MENU_CONTENT_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Content SIDs of the filing draft-choice and test-data-notice templates.
# Create/reuse them with `npm run twilio:filing:create` — see
# twilio/templates/filing-{draft-choice,notice}.{en,ml}.json.
TWILIO_FILING_DRAFT_CHOICE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_DRAFT_CHOICE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_NOTICE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_NOTICE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The exact public URL Twilio is configured to call, with no trailing slash
# (e.g. your Vercel production domain, or an HTTPS tunnel origin for local dev).
PUBLIC_BASE_URL=https://your-production-domain.vercel.app
# Postgres connection string for conversation/idempotency persistence
# (e.g. a Neon database provisioned through the Vercel Marketplace).
DATABASE_URL=

# --- Issue #16 Kapso migration spike (optional) ---------------------------
# Everything below is optional and defaults to disabled. Leave unset for a
# normal Twilio-only setup. Must never be set to "true" in Production — see
# docs/adr/kapso-vs-twilio.md once it exists, and issue #16 for the full gate.
#
# When "true", KAPSO_API_KEY, KAPSO_PHONE_NUMBER_ID, and KAPSO_WEBHOOK_SECRET
# below become required (enforced by src/config/env.ts at boot).
KAPSO_SPIKE_ENABLED=false
# From the Kapso dashboard, after connecting a Sandbox/test number.
KAPSO_API_KEY=
# The WhatsApp phone number id Kapso assigned to the connected test number.
KAPSO_PHONE_NUMBER_ID=
# Shown when registering a webhook URL in the Kapso dashboard against an
# isolated (non-production) deployment. Used to verify X-Webhook-Signature.
KAPSO_WEBHOOK_SECRET=
