# Server
# development | test | production
NODE_ENV=development
# Port for local development (ignored on Vercel)
PORT=3000

# Twilio WhatsApp Sandbox
# See docs/twilio-sandbox-setup.md for how to obtain these values.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Content SID of the oncourts_language_selection_v1 template. Create/reuse it
# with `npm run twilio:template:create` — see twilio/templates/language-selection.json.
TWILIO_LANGUAGE_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Content SIDs of the localized main-menu list-picker templates. Create/reuse
# them with `npm run twilio:menu:create` — see
# twilio/templates/complainant-advocate-menu.{en,ml}.json.
TWILIO_MAIN_MENU_CONTENT_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MAIN_MENU_CONTENT_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Content SIDs of the filing draft-choice and test-data-notice templates.
# Create/reuse them with `npm run twilio:filing:create` — see
# twilio/templates/filing-{draft-choice,notice}.{en,ml}.json.
TWILIO_FILING_DRAFT_CHOICE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_DRAFT_CHOICE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_NOTICE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_NOTICE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Case-type gating, inserted before FILING_NOTICE (see domain/case-type.ts):
# only cheque-bounce (S.138) is actually filed; every other case type is
# listed for transparency but always resolves to a "not available yet"
# reply. Create/reuse with `npm run twilio:case-type:create` — see
# twilio/templates/filing-case-type.{en,ml}.json and
# filing-other-case-types.{en,ml}.json.
TWILIO_FILING_CASE_TYPE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_CASE_TYPE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_OTHER_CASE_TYPES_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_OTHER_CASE_TYPES_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Quick-reply buttons for typed "done"/"skip"/"sample" shortcuts (complainant
# email, accused phone, filing details bank/branch and story, document
# upload, and the defect-2 re-upload screen). All three OPTIONAL — leave
# unset (or delete) and every field this touches keeps working exactly as it
# does today, with the same plain-text prompt and the same typed fallback;
# set them once you've provisioned the templates to turn the buttons on.
# Create/reuse with `npm run twilio:shared:create` — see
# twilio/templates/filing-field-skip.{en,ml}.json,
# filing-doc-continue.{en,ml}.json, and filing-doc-continue-only.{en,ml}.json.
TWILIO_FIELD_SKIP_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FIELD_SKIP_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DOC_CONTINUE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DOC_CONTINUE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DOC_CONTINUE_ONLY_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DOC_CONTINUE_ONLY_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Content SIDs of the complainant-details review-actions and edit-fields
# templates. Create/reuse them with `npm run twilio:complainant:create` —
# see twilio/templates/complainant-{review-actions,edit-fields}.{en,ml}.json.
TWILIO_COMPLAINANT_REVIEW_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_COMPLAINANT_REVIEW_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_COMPLAINANT_EDIT_FIELDS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_COMPLAINANT_EDIT_FIELDS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Content SIDs of the accused-details review-actions and edit-fields
# templates. Create/reuse them with `npm run twilio:accused:create` —
# see twilio/templates/accused-{review-actions,edit-fields}.{en,ml}.json.
TWILIO_ACCUSED_REVIEW_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCUSED_REVIEW_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCUSED_EDIT_FIELDS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCUSED_EDIT_FIELDS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #33 Part A. Content SIDs of the "Filing as" quick-reply template.
# Create/reuse with `npm run twilio:filing-details:create` — see
# twilio/templates/complainant-role.{en,ml}.json.
TWILIO_COMPLAINANT_ROLE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_COMPLAINANT_ROLE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #33 Part B. Content SIDs of the entity-type quick-reply template.
# See twilio/templates/accused-entity-type.{en,ml}.json.
TWILIO_ACCUSED_ENTITY_TYPE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCUSED_ENTITY_TYPE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #33 Part C. Content SIDs of the return-reason list-picker and
# paid-after-notice quick-reply templates. See
# twilio/templates/filing-{return-reason,part-payment}.{en,ml}.json.
TWILIO_FILING_RETURN_REASON_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_RETURN_REASON_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_PART_PAYMENT_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_PART_PAYMENT_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #33 Part D. Content SIDs of the witness quick-reply template. See
# twilio/templates/filing-witness.{en,ml}.json.
TWILIO_FILING_WITNESS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_WITNESS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #33 Part F. Content SIDs of the court select, combined-review actions, the
# 2-level edit picker, and the declaration templates. See
# twilio/templates/filing-{court,review-actions,edit-group,edit-cheque-field,edit-narrative-field,declare}.{en,ml}.json.
TWILIO_FILING_COURT_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_COURT_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_REVIEW_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_REVIEW_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_EDIT_GROUP_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_EDIT_GROUP_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_EDIT_CHEQUE_FIELD_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_EDIT_CHEQUE_FIELD_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_EDIT_NARRATIVE_FIELD_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_EDIT_NARRATIVE_FIELD_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_DECLARE_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_DECLARE_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #34. Content SIDs of the draft-ready "Review & e-Sign / Edit details"
# quick-reply template. Create/reuse with `npm run twilio:filing-sign:create`
# — see twilio/templates/filing-draft-ready-actions.{en,ml}.json.
TWILIO_FILING_DRAFT_READY_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_DRAFT_READY_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #35. Content SIDs of the filed-acknowledgement "Pay court fee" quick-reply
# template. Create/reuse with `npm run twilio:filing-completion:create` —
# see twilio/templates/filing-filed-actions.{en,ml}.json.
TWILIO_FILING_FILED_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_FILED_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #36. Content SIDs of the "My cases" sectioned list-picker (a fixed
# 10-row structure, filled per send via content variables) and the
# per-draft "Continue filing / Discard draft / Main menu" quick-reply.
# Create/reuse with `npm run twilio:filing-draft-list:create` — see
# twilio/templates/filing-draft-{list,detail-actions}.{en,ml}.json.
TWILIO_FILING_DRAFT_LIST_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_DRAFT_LIST_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_DRAFT_DETAIL_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FILING_DRAFT_DETAIL_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #37. Content SIDs of the case-status screen's "Simulate scrutiny defects"
# actions, the defect-alert/review/sent actions, and the days-of-delay
# select. Create/reuse with `npm run twilio:filing-defect:create` — see
# twilio/templates/{case-status-actions,defect-alert-actions,defect-days,defect-review-actions,defect-sent-actions}.{en,ml}.json.
TWILIO_CASE_STATUS_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CASE_STATUS_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFECT_ALERT_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFECT_ALERT_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFECT_DAYS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFECT_DAYS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFECT_REVIEW_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFECT_REVIEW_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFECT_SENT_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_DEFECT_SENT_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# #38. Content SIDs of the proactive hearing-reminder's "Yes, I'll attend" /
# "Seek an adjournment" actions. Create/reuse with
# `npm run twilio:hearing:create` — see
# twilio/templates/hearing-reminder-actions.{en,ml}.json. MUST be an
# approved WhatsApp Message Template before use on any non-Sandbox number —
# see src/services/hearing-sender.ts.
TWILIO_HEARING_REMINDER_ACTIONS_SID_EN=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_HEARING_REMINDER_ACTIONS_SID_ML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The exact public URL Twilio is configured to call, with no trailing slash
# (e.g. your Vercel production domain, or an HTTPS tunnel origin for local dev).
PUBLIC_BASE_URL=https://your-production-domain.vercel.app
# Postgres connection string for conversation/idempotency persistence
# (e.g. a Neon database provisioned through the Vercel Marketplace).
DATABASE_URL=
# Durable storage for uploaded filing documents (#31). Set automatically
# when a Vercel Blob store is linked to this Vercel project — see
# https://vercel.com/docs/vercel-blob.
BLOB_READ_WRITE_TOKEN=
# #40 (document auto-extraction) — optional. When unset, cheque/memo/notice
# photos are never read and every upload behaves exactly as before this
# feature existed (fully manual entry, no "reading" cascade).
# ANTHROPIC_BASE_URL/ANTHROPIC_MODEL let this point at a custom-hosted
# endpoint/deployment instead of api.anthropic.com directly.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
